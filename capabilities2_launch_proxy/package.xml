<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>capabilities2_launch_proxy</name>
  <version>0.0.0</version>
  <description>ROS 2 action server for starting, supervising, and stopping launch files with runtime resource feedback.</description>
  <maintainer email="kalanaratnayake95@gmail.com">kalana</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>capabilities2_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
